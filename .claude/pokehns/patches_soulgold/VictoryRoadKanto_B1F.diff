diff --git a/data/maps/VictoryRoadKanto_B1F/scripts.inc b/data/maps/VictoryRoadKanto_B1F/scripts.inc
index 369ca06f2d..d532d9c4fb 100644
--- a/data/maps/VictoryRoadKanto_B1F/scripts.inc
+++ b/data/maps/VictoryRoadKanto_B1F/scripts.inc
@@ -1,12 +1,53 @@
+
 VictoryRoadKanto_B1F_MapScripts::
+	map_script MAP_SCRIPT_ON_TRANSITION, VictoryRoadKanto_B1F_OnTransition
 	.byte 0
 
-VictoryRoadKanto_B1F_EventScript_Item_FullRestore::
-	finditem ITEM_FULL_RESTORE
+VictoryRoadKanto_B1F_OnTransition::
+	call Common_EventScript_SetupRivalGfxId
+    end
+
+
+
+MtSilver_1F_MoltresRoom_EventScript_MoltresRan::
+	release
 	end
-VictoryRoadKanto_B1F_EventScript_Item_HpUp::
-	finditem ITEM_HP_UP
+
+VictoryRoadKanto_B1F_EventScript_Moltres::
+	lock
+	faceplayer
+	legendaryencounter SPECIES_MOLTRES, 60, LOCALID_VICTORYROAD_MOLTRES, FLAG_HIDE_MOLTRES
+	release
+	end
+
+
+VictoryRoad_Rival::
+	goto_if_set FLAG_SPOKEN_VICTORYROAD_RIVAL, VictoryRoad_Rival_1
+	lock
+	faceplayer
+	createfieldmugshotrival
+	msgbox VictoryRoad_Rival_Text_0
+	setflag FLAG_SPOKEN_VICTORYROAD_RIVAL
+	release
 	end
-VictoryRoadKanto_B1F_EventScript_Item_MaxRevive::
-	finditem ITEM_MAX_REVIVE
+
+VictoryRoad_Rival_1:
+	goto VictoryRoad_Rival2
+	return
+
+
+VictoryRoad_Rival2::
+	lock
+	faceplayer
+	createfieldmugshotrival
+	msgbox VictoryRoad_Rival2_Text_0
+	release
 	end
+
+
+VictoryRoad_Rival_Text_0:
+	.string "Don't.$"
+
+VictoryRoad_Rival2_Text_0:
+	.string "I just need to train more.\p"
+	.string "That's all there ever is to it.$"
diff --git a/data/maps/VictoryRoadKanto_B1F/scripts.pory b/data/maps/VictoryRoadKanto_B1F/scripts.pory
new file mode 100644
index 0000000000..cbf502ef8d
--- /dev/null
+++ b/data/maps/VictoryRoadKanto_B1F/scripts.pory
@@ -0,0 +1,48 @@
+raw `
+VictoryRoadKanto_B1F_MapScripts::
+	map_script MAP_SCRIPT_ON_TRANSITION, VictoryRoadKanto_B1F_OnTransition
+	.byte 0
+
+VictoryRoadKanto_B1F_OnTransition::
+	call Common_EventScript_SetupRivalGfxId
+    end
+
+
+
+MtSilver_1F_MoltresRoom_EventScript_MoltresRan::
+	release
+	end
+`
+
+script VictoryRoadKanto_B1F_EventScript_Moltres {
+    lock
+    faceplayer
+    legendaryencounter(SPECIES_MOLTRES, 60, LOCALID_VICTORYROAD_MOLTRES, FLAG_HIDE_MOLTRES)
+    release
+    end
+}
+
+script VictoryRoad_Rival {
+    if (flag(FLAG_SPOKEN_VICTORYROAD_RIVAL)) {
+        goto(VictoryRoad_Rival2)
+    } else {
+        lock
+        faceplayer
+        createfieldmugshotrival
+        msgbox("Don't.")
+        setflag(FLAG_SPOKEN_VICTORYROAD_RIVAL)
+        release
+        end
+    }
+}
+
+script VictoryRoad_Rival2 {
+    lock
+    faceplayer
+    createfieldmugshotrival
+    msgbox("I just need to train more.
+            
+            That's all there ever is to it.")
+    release
+    end
+}
\ No newline at end of file
