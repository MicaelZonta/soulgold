 	waitse
 	playse SE_EXP_MAX
 	msgbox SaffronCity_FightingDojo_Ability_Finish_Text, MSGBOX_DEFAULT
-	removemoney 25000, 0
+	removemoney 1000000, 0
 	closemessage
 	release
 	end
