+Route27_RouteExpert::
+	lock
+	faceplayer
+	goto_if_set FLAG_ROUTE27_EXPERT, Route27_RouteExpert_2
+	msgbox Route27_RouteExpert_Text_1
+	goto_if_set FLAG_ROUTE27_EXPERT_QUALIFIED, Route27_RouteExpert_5
