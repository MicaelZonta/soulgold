diff --git a/data/maps/Route28/scripts.inc b/data/maps/Route28/scripts.inc
index 1db29e9178..ef0eabde27 100644
--- a/data/maps/Route28/scripts.inc
+++ b/data/maps/Route28/scripts.inc
@@ -1,3 +1,4 @@
+
 Route28_MapScripts::
 	map_script MAP_SCRIPT_ON_TRANSITION, Route28_OnTransition
 	map_script MAP_SCRIPT_ON_RESUME, SetTimeEncounters
@@ -12,4 +13,15 @@ Route28_EventScript_Sign::
 	end
 
 Route28_Text_Sign:
-	.string "ROUTE 28$"
+	.string "Route 28$"
+
+Route28Guard::
+	msgbox Route28Guard_Text_0, MSGBOX_NPC
+	return
+
+
+Route28Guard_Text_0:
+	.string "The road beyond leads to the fierce\n"
+	.string "heights of Mt Silver. Only those with\l"
+	.string "explicit permission from the League\l"
+	.string "are allowed to explore further.$"
diff --git a/data/maps/Route28/scripts.pory b/data/maps/Route28/scripts.pory
new file mode 100644
index 0000000000..2a482263b9
--- /dev/null
+++ b/data/maps/Route28/scripts.pory
@@ -0,0 +1,24 @@
+raw `
+Route28_MapScripts::
+	map_script MAP_SCRIPT_ON_TRANSITION, Route28_OnTransition
+	map_script MAP_SCRIPT_ON_RESUME, SetTimeEncounters
+	.byte 0
+
+Route28_OnTransition: 
+	callnative SetTimeBasedEncounters
+	end
+
+Route28_EventScript_Sign::
+	msgbox Route28_Text_Sign, MSGBOX_SIGN
+	end
+
+Route28_Text_Sign:
+	.string "Route 28$"
+`
+
+script Route28Guard {
+    msgbox("The road beyond leads to the fierce
+            heights of Mt Silver. Only those with
+            explicit permission from the League
+            are allowed to explore further.", MSGBOX_NPC)
+}
