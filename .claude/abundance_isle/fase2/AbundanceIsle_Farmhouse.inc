AbundanceIsle_Farmhouse_EventScript_Grandpa::
	msgbox AbundanceIsle_Farmhouse_EventScript_Grandpa_Text, MSGBOX_NPC
	end

AbundanceIsle_Farmhouse_EventScript_Grandpa_Text:
	.string "When I was a boy, the old folk\n"
	.string "told of a year with no harvest.\p"
	.string "“The cold star fell,” they said.\n"
	.string "I thought it was just a story.$"

AbundanceIsle_Farmhouse_EventScript_Wife::
	msgbox AbundanceIsle_Farmhouse_EventScript_Wife_Text, MSGBOX_NPC
	end

AbundanceIsle_Farmhouse_EventScript_Wife_Text:
	.string "Help yourself to some tea, dear.\n"
	.string "It's the only warm thing left\n"
	.string "on this island.$"

