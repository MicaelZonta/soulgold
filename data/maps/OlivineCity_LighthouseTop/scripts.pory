mapscripts OlivineCity_LighthouseTop_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // Anfitriao de personagem de agenda (Colress/Soliera):
        // data/scripts/birth_island_residents.inc
        call(ScheduledNpcs_OnTransition)
        if (flag(FLAG_HIDE_ZAPDOS_GALAR) == FALSE) {
            setweather(WEATHER_RAIN_THUNDERSTORM)
        } else {
            setweather(WEATHER_NONE)
        }
    }
}

script Lighthousetop_Zapdos {
    lock
    faceplayer
    bosslegendaryencounter(SPECIES_ZAPDOS_GALAR, 60, LOCALID_LIGHTHOUSE_ZAPDOS, FLAG_HIDE_ZAPDOS_GALAR, 2)
    release
    end
}

script Lighthouse_Engineer {
    lock
    faceplayer
    msgbox("Some Pokémon broke the ladder to the
            top floor recently.
            
            I'm trying to fix it, but it
            will take some time.")
    release
    end
}