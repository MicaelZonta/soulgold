mapscripts Kitakami_Houses_MapScripts {}

script KitakamiHouses_1_Oldman {
    lock
    faceplayer
    if (flag(FLAG_CANDY_KITAKAMI)) {
        msgbox("Come back tomorrow when I have
                prepared another batch!")
        release
        end
    }
    msgbox("Ho ho ho! 
    
            I'm the best candy baker in the
            entire Johto! 
            
            Here, have some from my daily batch!")
    random(3)
    switch (var(VAR_RESULT)) {
        case 0:
        giveitem(ITEM_EXP_CANDY_M, 3)
        case 1:
        giveitem(ITEM_EXP_CANDY_L, 2)
        giveitem(ITEM_EXP_CANDY_M, 1)
        case 2:
        giveitem(ITEM_EXP_CANDY_XL, 1)
        giveitem(ITEM_EXP_CANDY_L, 1)
    }
    setflag(FLAG_CANDY_KITAKAMI)
    msgbox("Come back tomorrow when I have
            prepared another batch!")
    release
    end

}

script KitakamiHouses_3_Sinistea {
    lock
    faceplayer
    playmoncry(SPECIES_SINISTEA, CRY_MODE_NORMAL)
    msgbox("Sinistea: Siii!")
    waitmoncry
    release
    end
}

script KitakamiHouses_2_Steven {
    lock
    faceplayer
    if (flag(FLAG_MET_STEVEN)) {
        if (flag(FLAG_IS_CHAMPION)) {
            // Champion and received Beldum
            if (!flag(FLAG_TEMP_10)) {
                playse(SE_PIN)
                applymovement(LOCALID_KITAKAMI_STEVEN, Common_Movement_ExclamationMark)
                applymovement(LOCALID_KITAKAMI_STEVEN, moves(face_player))
                waitmovement(0)
                waitse
                msgbox("That face of determination... I assume
                        you have become the Champion of Johto?

                        ...

                        Impressive! I was right about your
                        potential as a trainer.

                        I'd be more than happy to battle you
                        now, if you are alright with that.")
                setflag(FLAG_TEMP_10)
            }
            msgbox("Are you ready to face me?", MSGBOX_YESNO)
            if (var(VAR_RESULT) == YES) {
                //Do battle
                msgbox("Splendid, I'll hold nothing back
                        and I expect you to do the same!")
                trainerbattle_no_intro(TRAINER_STEVEN, "Outstanding, you truly have earned
                                                        the title of a Champion.")
                msgbox("It cannot be overstated how happy
                        this battle made me. 
                        
                        You are a trainer of exceptional skill.
                        
                        I want you to have this as a gift
                        of our meeting. 
                        
                        I excavated it from the mountain. 
                        up north. 
                        
                        You might find some use for it 
                        near Route 47.")
                giveitem(ITEM_JADE_ORB)
                waitmessage
                msgbox("I think I'll start heading out to 
                        explore new places now. 
                        
                        I hope our paths cross again some day, 
                        {PLAYER}.")
                waitmessage
                closemessage
                setflag(FLAG_BEAT_STEVEN_KITAKAMI)
                moveobjecttocoords(LOCALID_KITAKAMI_STEVEN, 28, 8, DIR_SOUTH)
                waitmovement(LOCALID_KITAKAMI_STEVEN)
                delay(15)
                playse(SE_EXIT)
                
                removeobject(LOCALID_KITAKAMI_STEVEN)
                release
                end
            } else {
                // Decline Battle
                release
                end
            }
        } else {
            // Not yet champion but received Beldum
            msgbox("If you end up becoming a Champion of
                    the region, you should come see me.

                    I would love to battle you with my
                    full strength.")
        }
        release
        end
    }
    // First time meeting
    msgbox("Oh, hello. Who might you be?

            ...

            {PLAYER}? 
            Nice to meet you.

            My name is Steven, I hail from the Hoenn
            region in search of rare stones.")
    msgbox("You look like a trainer, are you on the
            quest to collect badges in Johto?

            Hmm.. Perhaps... 
            
            Yes, you may have the
            potential for what it takes.

            Would you be willing to hear my request?

            I would like you to have this Beldum.
            It's a rare Pokémon from Hoenn.

            Take care of it and come see me again
            if you become the Champion. 
            
            I would like to battle you then 
            in return.")
    setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_BELDUM)
    bufferspeciesname(STR_VAR_1, SPECIES_BELDUM)
    givemon(SPECIES_BELDUM, 15, ITEM_IRON_BALL, ITEM_LUXURY_BALL)
    showgivemonpic(10, 3)
    call(Common_EventScript_GiftMon)
    hidemonpic
    setflag(FLAG_MET_STEVEN)
    createfieldmugshot(MUGSHOT_STEVEN)
    msgbox("I have high expectations for you.")
    waitmessage
    release
    end
}

script PorygonPC {
    lockall
	playmoncry(SPECIES_PORYGON_Z, CRY_MODE_NORMAL)
	msgbox("{PLAYER} booted up the Porygon 
            remote PC.")
	goto(EventScript_PCMainMenu)
}

// Tea-set collector: sells the rare Formes nothing else in the game gives
// (Antique Sinistea, Artisan Poltchageist), so Antique Polteageist and
// Masterpiece Sinistcha can be reached with the Chipped Pot / Masterpiece
// Teacup. Temporary home until a proper event (.claude/evolucoes.md).
// Room is checked BEFORE the offer (skill entregar-pokemon-ou-ovo).
script KitakamiHouses_3_Lady {
    lock
    faceplayer
    getpartysize
    if (var(VAR_RESULT) == PARTY_SIZE) {
        specialvar(VAR_RESULT, ScriptCheckFreePokemonStorageSpace)
        if (var(VAR_RESULT) == FALSE) {
            msgbox("I'd show you my collection, but your
                    team is full and so are your boxes.

                    Make some room and come back!")
            release
            end
        }
    }
    showmoneybox(0, 0)
    msgbox("I collect old tea sets. Every so often
            a cup or a pot comes with someone
            still living in it.

            I can't keep them all. ¥20,000 and
            one of them goes home with you.")
    dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, "Antique Sinistea", "Artisan Poltchageist", "No thanks")
    switch (var(VAR_RESULT)) {
        case 0:
            setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_SINISTEA_ANTIQUE)
        case 1:
            setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_POLTCHAGEIST_ARTISAN)
        default:
            hidemoneybox
            msgbox("Oh well. They're good company anyway.")
            release
            end
    }
    checkmoney(20000)
    if (var(VAR_RESULT) == FALSE) {
        hidemoneybox
        msgbox("Oh dear, you're a little short.
                They'll still be here!")
        release
        end
    }
    bufferspeciesname(STR_VAR_1, VAR_TEMP_TRANSFERRED_SPECIES)
    givemon(VAR_TEMP_TRANSFERRED_SPECIES, 30)
    // Defensive: the check before the offer already guarantees room.
    if (var(VAR_RESULT) == MON_CANT_GIVE) {
        hidemoneybox
        msgbox("Hm, there's nowhere for it to go.
                Make some room and come back!")
        release
        end
    }
    removemoney(20000)
    updatemoneybox
    call(Common_EventScript_GiftMon)
    hidemoneybox
    msgbox("Treat it gently. A chipped pot or a
            masterpiece teacup will help it grow.")
    release
    end
}

