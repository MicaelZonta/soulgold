raw `
.set LOCALID_OLIVINE_SABRINA, 3

OlivineCity_PortOutside_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, OlivineCity_MapScript_OnTransition
	.byte 0

OlivineCity_PortOutside_EventScript_Sabrina::
    lock
    faceplayer
    msgbox OlivineCity_PortOutside_Text_Sabrina, MSGBOX_DEFAULT
    closemessage
    fadescreenswapbuffers FADE_TO_BLACK
    setflag FLAG_HIDE_OLIVINE_SABRINA
    removeobject LOCALID_OLIVINE_SABRINA
    fadescreenswapbuffers FADE_FROM_BLACK
    clearflag FLAG_HIDE_DOJO_SABRINA
    release
    end

OlivineCity_PortOutside_Text_Sabrina:
    .string "{SPEAKER NAME_SABRINA}Out of the blue,\n"
	.string "I get the urge to see the ocean.\p"
	.string "I'll see you at the Fighting\n"
	.string "Dojo.$"

OlivineCity_PortOutside_EventScript_Fisherman1::
	lock
	faceplayer
	msgbox OlivineCity_PortOutside_Text_PortFisherman1, MSGBOX_DEFAULT
	closemessage
	release
	end

OlivineCity_PortOutside_EventScript_Fisherman2::
	lock
	faceplayer
	msgbox OlivineCity_PortOutside_Text_Fisherman2, MSGBOX_DEFAULT
	closemessage
	release
	end

OlivineCity_PortOutside_Text_PortFisherman1:
	.string "Fast Ship S.S.Aqua used to sail to\n"
	.string "Kanto on Mondays and Fridays. But\l"
	.string "now, it sails almost constantly!$"

OlivineCity_PortOutside_Text_Fisherman2:
	.string "Aw yeah, I'm fishin'.$"

@ Barco para a Abundance Isle (depois da Liga). Volta pelo marinheiro do cais da ilha.
OlivineCity_PortOutside_EventScript_AbundanceSailor::
	lock
	faceplayer
	goto_if_unset FLAG_SYS_GAME_CLEAR, OlivineCity_PortOutside_EventScript_AbundanceSailorNotYet
	msgbox OlivineCity_PortOutside_Text_AbundanceSailorOffer, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, OlivineCity_PortOutside_EventScript_AbundanceSailorNo
	msgbox OlivineCity_PortOutside_Text_AbundanceSailorGo, MSGBOX_DEFAULT
	closemessage
	warp MAP_ABUNDANCE_ISLE, 23, 49
	waitstate
	release
	end

OlivineCity_PortOutside_EventScript_AbundanceSailorNotYet::
	msgbox OlivineCity_PortOutside_Text_AbundanceSailorNotYet, MSGBOX_DEFAULT
	release
	end

OlivineCity_PortOutside_EventScript_AbundanceSailorNo::
	msgbox OlivineCity_PortOutside_Text_AbundanceSailorNo, MSGBOX_DEFAULT
	release
	end

OlivineCity_PortOutside_Text_AbundanceSailorNotYet:
	.string "There's a farming island far to the\n"
	.string "south called Abundance Isle.\p"
	.string "Only League Champions get a seat\n"
	.string "on my boat, though. Rules are rules!$"

OlivineCity_PortOutside_Text_AbundanceSailorOffer:
	.string "Word is Abundance Isle got snow\n"
	.string "in the middle of harvest season...\p"
	.string "Want me to take you there?$"

OlivineCity_PortOutside_Text_AbundanceSailorGo:
	.string "Hold on tight! Next stop,\n"
	.string "Abundance Isle!$"

OlivineCity_PortOutside_Text_AbundanceSailorNo:
	.string "Come back anytime. The boat's\n"
	.string "always ready for a Champion.$"
`

script OlivinePortFisher {
    msgbox("I heard the ship broke down,
            I wonder when it will sail again.", MSGBOX_NPC)
}